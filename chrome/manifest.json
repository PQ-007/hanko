{
  "manifest_version": 3,
  "name": "Vocab Decks (for 10ten Japanese Reader)",
  "version": "1.0.0",
  "description": "Save words you look up with 10ten Japanese Reader into decks, then export them as an Anki-ready file.",
  "permissions": ["contextMenus", "storage", "activeTab", "identity", "alarms", "notifications"],
  "host_permissions": ["https://jisho.org/*", "https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Vocab Decks"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-word": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save selected word to a vocab deck"
    }
  }
}
