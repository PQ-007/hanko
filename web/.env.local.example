# Copy to .env.local and fill in. Get these from your Supabase project
# (Settings -> API). The publishable key is safe to expose to the browser/
# extension because Row Level Security protects every row.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New Supabase projects issue a publishable key (sb_publishable_...). Older
# projects use a legacy anon key — either works; set whichever you have.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public base URL of this site (used for OAuth redirects). For local dev:
# http://localhost:3000 ; in production set your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the text-to-speech provider. Defaults to "google-translate"
# (unofficial, no key needed). Set to "google-cloud" and provide the API key to
# use the official Google Cloud Text-to-Speech API instead.
# TTS_PROVIDER=google-translate
# GOOGLE_CLOUD_TTS_API_KEY=

# Mongolian translation (English -> Mongolian) uses the keyless Google Translate
# endpoint server-side. Nothing to configure.

# Optional: lets /api/distractors (Monster Hunt's wrong-answer generator)
# persist Jisho lookups into the shared distractor_cache table instead of
# re-fetching Jisho on every request. Get from Supabase dashboard -> Settings
# -> API -> "service_role" secret. NEVER expose this to the browser or commit
# it — unlike the publishable key above, it bypasses Row Level Security
# entirely. Safe to leave unset: without it the route still works, it just
# can't warm the cache, so every request hits Jisho fresh.
# SUPABASE_SERVICE_ROLE_KEY=
