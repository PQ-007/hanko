# Copy to .env.local and fill in. Get these from your Supabase project
# (Settings -> API). The anon key is safe to expose to the browser/extension
# because Row Level Security protects every row.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public base URL of this site (used for OAuth redirects). For local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the text-to-speech provider. Defaults to "google-translate"
# (unofficial, no key needed). Set to "google-cloud" and provide the API key to
# use the official Google Cloud Text-to-Speech API instead.
# TTS_PROVIDER=google-translate
# GOOGLE_CLOUD_TTS_API_KEY=
